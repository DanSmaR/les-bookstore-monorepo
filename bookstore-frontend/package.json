    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.8.1",
    "react-router-dom": "^7.9.5",
    "styled-components": "^6.1.19",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/cypress": "^10.1.0",
