# Test Environment Configuration
# This file is used when running E2E tests with Cypress

NODE_ENV=test
PORT=3000

# Test Database Configuration (Docker container on port 5433)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bookstore_test_db

# JWT Configuration
JWT_SECRET=test-secret-key-change-this-in-production
JWT_EXPIRATION_TIME=8h

# PostgreSQL SSL Configuration
POSTGRES_SSL_REJECT_UNAUTHORIZED=false
